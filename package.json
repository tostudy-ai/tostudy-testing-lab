{
  "name": "tostudy-testing-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:baseline": "vitest run --config vitest.baseline.config.ts",
    "test:related": "vitest related --run",
    "e2e:run": "playwright test",
    "challenge": "tsx scripts/challenges.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm e2e:run"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
